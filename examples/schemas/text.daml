{
  types: {
    text.Request: {
      schema: {
        $id: "https://daml.invalid/text/request"
        type: "object"
        description: '''
          A request schema expressed in DAML using
          the same JSON Schema keywords as the JSON representation.
        '''
        properties: {
          instruction: {
            type: "string"
            minLength: 1
          }
          context: {
            type: "string"
            default: ""
          }
          request_id: {
            type: "string"
            default: "local"
          }
        }
        required: [
          "instruction"
          "context"
        ]
        additionalProperties: false
      }
    }
  }
}
