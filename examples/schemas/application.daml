{
  types: {
    demo.Application: {
      schema: {
        $id: "https://daml.invalid/demo/application"
        type: "object"
        properties: {
          adapter: { x-daml-slot: "app.Adapter" }
          tasks: {
            type: "array"
            items: { x-daml-slot: "app.Stage" }
          }
          ports: { $ref: "https://daml.invalid/network/ports" }
          enabled: {
            type: "boolean"
            default: true
          }
          optional: {
            type: [
              "null"
              "string"
            ]
            default: null
          }
          exact: { type: "integer" }
        }
        required: [
          "adapter"
          "tasks"
          "ports"
          "exact"
        ]
        additionalProperties: false
      }
    }
    demo.Task: {
      schema: {
        $id: "https://daml.invalid/demo/task"
        type: "object"
        properties: {
          request: { $ref: "https://daml.invalid/text/request" }
        }
        required: ["request"]
        additionalProperties: false
      }
      implements: ["app.Stage"]
    }
  }
  contracts: {
    app.Adapter: { type: "object" }
    app.Stage: {
      type: "object"
      properties: {
        request: { type: "object" }
      }
      required: ["request"]
    }
  }
}
