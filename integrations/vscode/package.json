{
  "name": "definitively-asserted-daml",
  "displayName": "Definitively Asserted DAML",
  "description": "Syntax highlighting, formatting, and explicitly selected schema-aware authoring for DAML documents.",
  "version": "0.2.1",
  "publisher": "dprb-work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dprb-work/daml.git",
    "directory": "integrations/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:definitively-asserted-daml"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting remains available; the language server starts only after workspace trust is granted."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "definitivelyAssertedDaml.useConfiguration",
        "category": "DAML",
        "title": "Use Configuration Context",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "definitivelyAssertedDaml.useDefinition",
        "category": "DAML",
        "title": "Use Definition Context",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "definitivelyAssertedDaml.useSyntax",
        "category": "DAML",
        "title": "Use Syntax Only",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "definitivelyAssertedDaml.useConfiguration",
          "when": "editorLangId == definitively-asserted-daml"
        },
        {
          "command": "definitivelyAssertedDaml.useDefinition",
          "when": "editorLangId == definitively-asserted-daml"
        },
        {
          "command": "definitivelyAssertedDaml.useSyntax",
          "when": "editorLangId == definitively-asserted-daml"
        }
      ]
    },
    "languages": [
      {
        "id": "definitively-asserted-daml",
        "aliases": ["Definitively Asserted DAML", "DAML"],
        "extensions": [".daml"],
        "filenames": ["daml.bundle"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "definitively-asserted-daml",
        "scopeName": "source.daml",
        "path": "./syntaxes/daml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Definitively Asserted DAML",
      "properties": {
        "definitivelyAssertedDaml.serverPath": {
          "type": "string",
          "default": "daml-lsp",
          "description": "Path to the daml-lsp executable. Set an absolute path in user settings; workspace overrides are not permitted.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "prepare:client": "node scripts/prepare-client.mjs",
    "build": "npm run prepare:client && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --metafile=dist/meta.json --outfile=dist/extension.js && node scripts/stage-runtime-assets.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "npm run prepare:client && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@vscode/vsce@4.0.0": {
      "minimatch": "11.0.1",
      "@azure/identity@4.14.0": {
        "@azure/msal-node": "7.1.0"
      }
    }
  }
}
