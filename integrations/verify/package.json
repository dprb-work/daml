{
  "name": "@dprb-work/daml-integration-verify",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated real-host verification for installable DAML integrations.",
  "scripts": {
    "test:grammar": "node vscode/grammar.test.cjs",
    "test:client-lifecycle": "node --test vscode/dependency-lifecycle.test.cjs",
    "test:client-dependencies": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/dependency-run.mjs",
    "test:client-writer": "node vscode/writer-run.mjs",
    "test:client-consumers": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/consumer-run.mjs",
    "test:vscode:root-consumers": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/root-consumer-run.mjs",
    "test:vscode:adversarial": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/adversarial-run.mjs",
    "test:vscode": "npm run test:client-lifecycle && npm run test:client-dependencies && npm run test:client-writer && npm run test:client-consumers && npm run test:vscode:lifecycle && npm run test:vscode:root-consumers && npm run test:vscode:adversarial && npm run test:vscode:semantic",
    "test:vscode:lifecycle": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/run.mjs",
    "test:vscode:semantic": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/semantic-run.mjs",
    "test:vscode:visual": "xvfb-run --auto-servernum --server-args='-screen 0 1440x1000x24' node vscode/visual.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
