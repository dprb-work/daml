{
  types: {
    demo.Application: {
      schema: {
        $id: "https://daml.invalid/demo/application"
        type: "object"
        properties: {
          adapter: { $ref: "https://daml.invalid/app/adapter" }
          tasks: {
            type: "array"
            items: { $ref: "https://daml.invalid/app/stage" }
          }
          ports: { $ref: "https://daml.invalid/network/ports" }
          enabled: {
            type: "boolean"
            default: true
          }
          optional: {
            type: [
              "null"
              "string"
            ]
            default: null
          }
          exact: { type: "integer" }
        }
        required: [
          "adapter"
          "tasks"
          "ports"
          "exact"
        ]
        additionalProperties: false
      }
    }
    demo.Task: {
      schema: {
        $id: "https://daml.invalid/demo/task"
        type: "object"
        properties: {
          request: { $ref: "https://daml.invalid/text/request" }
        }
        required: ["request"]
        additionalProperties: false
      }
    }
  }
  resources: [
    {
      uri: "https://daml.invalid/app/adapter"
      schema: { type: "object" }
    }
    {
      uri: "https://daml.invalid/app/stage"
      schema: {
        type: "object"
        properties: {
          request: { type: "object" }
        }
        required: ["request"]
      }
    }
  ]
}
